PORT=3000
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

DB_USER=postgres
DB_HOST=localhost
DB_NAME=igreja
DB_PASSWORD=troque-esta-senha
DB_PORT=5432
DB_SSL=false
# Para CA privada, use PEM com quebras de linha escapadas como \n.
DB_SSL_CA=

# Separe origens web por vírgula. Apps nativos não enviam o cabeçalho Origin.
CORS_ORIGINS=http://localhost:8081
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=4mb
MAX_IMAGE_BYTES=2000000
LOGIN_RATE_LIMIT=10
CADASTRO_RATE_LIMIT=5

# Recuperação de senha por e-mail (Resend). Não coloque valores reais no Git.
# Verifique um domínio remetente no provedor antes de habilitar a rota.
RESEND_API_KEY=
EMAIL_FROM=
RESET_REQUEST_RATE_LIMIT=5
RESET_VERIFY_RATE_LIMIT=10

# Armazenamento Cloudinary: habilite somente após migração e homologação.
CLOUDINARY_MURAL_ENABLED=false
# Utilize apenas a chave restrita à pasta agenda-adp; nunca a chave Root.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fotos de perfil protegidas; não habilite antes da homologação.
CLOUDINARY_PROFILE_ENABLED=false
# Origem HTTPS da própria API (não do frontend); sem barra final.
PROFILE_MEDIA_BASE_URL=
