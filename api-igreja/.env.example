PORT=3000
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

DB_USER=postgres
DB_HOST=localhost
DB_NAME=igreja
DB_PASSWORD=troque-esta-senha
DB_PORT=5432
DB_SSL=false
# Para CA privada, use PEM com quebras de linha escapadas como \n.
DB_SSL_CA=

# Separe origens web por vírgula. Apps nativos não enviam o cabeçalho Origin.
CORS_ORIGINS=http://localhost:8081
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=4mb
MAX_IMAGE_BYTES=2000000
LOGIN_RATE_LIMIT=10
CADASTRO_RATE_LIMIT=5
